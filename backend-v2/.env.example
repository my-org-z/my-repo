# Environment Configuration for HintAI V2

# Server
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hintai_v2

# Security
SECRET_KEY=your-secret-key-here-use-argon2-to-generate
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Mistral AI
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=pixtral-12b
MISTRAL_EMBEDDING_MODEL=mistral-embed

# Redis (for Celery and caching)
REDIS_URL=redis://localhost:6379/0

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=.pdf,.jpg,.jpeg,.png

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_MINUTES=1

# Payment (TMoney, Mobile Money)
TMONEY_API_KEY=
TMONEY_API_URL=
MOMO_API_KEY=
MOMO_API_URL=

# Sentry (Error Monitoring)
SENTRY_DSN=
