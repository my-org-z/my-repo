# Database (SQLite par défaut)
DATABASE_URL=sqlite:///./db/hints.db

# Pour Neon PostgreSQL:
# DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/dbname

# Mobile Money
TMONEY_API_KEY=
MOMO_API_KEY=

# Security
SECRET_KEY=your_secure_random_key_here
